    "viewRule": null,
    "createRule": null,
    "updateRule": null,
    "deleteRule": null,
    "options": {
      "query": "select \n  r.match as id,\n  r.match as match_id,\n  sum(case \n    when r.homeScore > r.awayScore  then 1\n    else 0\n    end\n  ) as home_per,\n  sum(case \n    when r.homeScore < r.awayScore  then 1\n    else 0\n    end\n  ) as away_per,\n  sum(case \n    when r.homeScore = r.awayScore  then 1\n    else 0\n    end\n  ) as tie_per\nfrom predictions r\ngroup by r.match"
    }
  },
