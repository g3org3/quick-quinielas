    "options": {
      "query": "WITH scored AS (\n    SELECT\n      p.id AS prediction_id,\n      p.homeScore = m.homeScore\n        AND p.awayScore = m.awayScore AS exact_score,\n\n      (\n        (p.homeScore > p.awayScore AND m.homeScore > m.awayScore) OR\n        (p.homeScore < p.awayScore AND m.homeScore < m.awayScore) OR\n        (p.homeScore = p.awayScore AND m.homeScore = m.awayScore)\n      ) AS correct_result,\n\n      m.first_goal != ''\n        AND m.first_goal = p.first_goal AS correct_first_goal,\n\n      m.first_goal_from  != ''\n        AND m.first_goal_from = p.first_goal_from AS correct_first_goal_from,\n\n      m.penalty_winner != ''\n        AND m.penalty_winner = p.penalty_winner as correct_penalty_winner\n\n    FROM predictions p\n    JOIN matches m ON m.id = p.match\n    WHERE m.startAtUtc < datetime()\n  ),\n\n  points AS (\n    SELECT\n      *,\n      (\n        CASE\n          WHEN exact_score THEN 3\n          WHEN correct_result THEN 1\n          ELSE 0\n        END\n        +\n        CASE WHEN correct_first_goal THEN 1 ELSE 0 END\n        +\n        CASE WHEN correct_first_goal_from THEN 1 ELSE 0 END\n        +\n        CASE WHEN correct_penalty_winner THEN 1 ELSE 0 END\n      ) AS base_points\n    FROM scored\n  )\n\n  SELECT\n    (row_number() OVER ()) AS id,\n      p.user,\n      p.homeScore AS p_home,\n      p.awayScore AS p_away,\n      p.isBonusActive,\n      p.first_goal as p_first_goal,\n      p.first_goal_from as p_first_goal_from,\n\n      m.id AS match_id,\n      m.tournament AS tournament_id,\n      m.home,\n      m.homeScore,\n      m.away,\n      m.awayScore,\n      m.startAtUtc,\n      m.first_goal,\n      m.first_goal_from,\n\n    (base_points * CASE WHEN isBonusActive THEN 2 ELSE 1 END) AS points,\n    pp.exact_score,\n    pp.correct_result,\n    pp.correct_first_goal,\n    pp.correct_first_goal_from,\n    pp.correct_penalty_winner\n  FROM points pp\nJOIN predictions p on p.id = pp.prediction_id\nJOIN matches m ON m.id = p.match"
    }
