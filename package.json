{
  "name": "quick-quinielas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:functions": "netlify functions:serve",
    "build": "tsc && vite build",
    "posthog:sourcemaps": "posthog-cli sourcemap inject --directory ./dist/assets && posthog-cli sourcemap upload --directory ./dist/assets --release-name quick-quinielas --delete-after",
    "build:netlify": "pnpm build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "types": "pocketbase-typegen --json ./pb_schema.json && mv ./pocketbase-types.ts ./src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@posthog/react": "^1.10.0",
    "@sentry/react": "^10.56.0",
    "@tanstack/eslint-plugin-query": "^5.43.1",
    "@tanstack/react-query": "^5.45.1",
    "@tanstack/react-query-devtools": "^5.45.1",
    "@tanstack/react-router": "^1.39.4",
    "@tanstack/react-table": "^8.17.3",
    "@types/luxon": "^3.4.2",
    "framer-motion": "^11.2.11",
    "luxon": "^3.4.4",
    "netlify-cli": "^26.1.0",
    "pocketbase": "^0.21.3",
    "pocketbase-typegen": "1.2.1",
    "posthog-js": "^1.382.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.6.0",
    "sweetalert2": "^11.26.25",
    "vaul": "^1.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@posthog/cli": "^0.7.34",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-devtools": "^1.39.4",
    "@tanstack/router-vite-plugin": "^1.39.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
