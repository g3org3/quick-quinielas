    "deleteRule": null,
    "options": {
      "query": "SELECT \n  (row_number() over()) as id,\n  p.user,\n  m.id as match_id,\n  m.tournament as tournament_id,\n  p.homeScore as p_home,\n  p.awayScore as p_away,\n  m.home,\n  m.homeScore,\n  m.away,\n  m.awayScore,\n  p.id as prediction_id,\n  m.startAtUtc,\n  (case \n    when p.homeScore = m.homeScore and p.awayScore = m.awayScore and p.isBonusActive then 6\n    when p.homeScore > p.awayScore and m.homeScore > m.awayScore and p.isBonusActive  then 2\n    when p.homeScore < p.awayScore and m.homeScore < m.awayScore and p.isBonusActive  then 2\n    when p.homeScore = p.awayScore and m.homeScore = m.awayScore and p.isBonusActive  then 2\n  \n    when p.homeScore = m.homeScore and p.awayScore = m.awayScore  then 3\n    when p.homeScore > p.awayScore and m.homeScore > m.awayScore  then 1\n    when p.homeScore < p.awayScore and m.homeScore < m.awayScore  then 1\n    when p.homeScore = p.awayScore and m.homeScore = m.awayScore  then 1\n    else 0\n  end) as points,\n  p.isBonusActive\nFROM predictions p\nJOIN matches m on m.id = p.match\nwhere m.`startAtUtc` < datetime()"
    }
  },
