    "createRule": null,
    "updateRule": null,
    "deleteRule": null,
    "options": {
      "query": "select \n  concat(r.user, '-', r.tournament_id) as id,\n  r.user,\n  r.tournament_id,\n  sum(points) as points\nfrom users u\ninner join results r on r.user = u.id\n  where u.ignore != true\ngroup by r.user, r.tournament_id"
    }
  },
